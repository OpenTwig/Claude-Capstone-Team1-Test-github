# Copy to .env (git-ignored) and fill in. `scripts/setup_local_db.py` fills in
# SECRET_KEY, FIELD_ENCRYPTION_KEYS, and both database passwords for you.
# Never commit real values. See "Configuration" in docs/design.md.

# development | test | production (defaults to production, the strictest)
APP_ENV=development

# Signs sessions and CSRF tokens. Generate with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Application database account (trading_app)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trading_db
DB_USER=trading_app
DB_PASSWORD=

# Migration account (trading_migrate), used only by `flask db-upgrade`
DB_MIGRATE_USER=trading_migrate
DB_MIGRATE_PASSWORD=

# Database used by the test suite (emptied and rebuilt by tests)
DB_TEST_NAME=trading_test

# Fernet keys for encrypting SSNs and bank account numbers, comma-separated,
# newest first. Generate one with:
#   .venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# Optional: defaults shown
# MARKET_TIMEZONE=America/Phoenix
# PRICE_TICK_MIN_SECONDS=30
# PRICE_TICK_MAX_SECONDS=120
# PRICE_DAILY_VOLATILITY_PCT=1.5
# PRICE_MAX_TICK_CHANGE_PCT=1.0
# STALE_PRICE_SECONDS=300
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
# REMEMBER_DAYS=30
# TEMP_PASSWORD_DAYS=7
# SUPPORT_EMAIL=support@example.com
# SUPPORT_HOURS=Monday–Friday, 9:00 AM–5:00 PM Arizona time
