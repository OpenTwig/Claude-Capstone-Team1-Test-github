# Copy to .env (git-ignored) and fill in. Never commit real values.

# Signs login sessions and form tokens. Generate one with:
# Linux/macOS:
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(48))"
# Windows:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=

# The MySQL or MariaDB database and the account the app logs in with
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trading_db
DB_USER=trading_app
DB_PASSWORD=

# Encrypts SSNs and bank account numbers. Generate one with:
# Linux/macOS:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Windows:
#   .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: if it is lost, stored SSNs and account numbers can't be read.
FIELD_ENCRYPTION_KEY=

# The first administrator. When the site starts and there is no administrator yet, it creates one
# with this email and password (at least 12 characters). After that these are not used, and you
# can leave them blank. Change the administrator's name on the Administration page.
ADMIN_EMAIL=
ADMIN_PASSWORD=
