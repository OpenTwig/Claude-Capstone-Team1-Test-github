# The web app (task 6.1; D28). Install to /etc/systemd/system/, then: systemctl enable --now trading-web
# Secrets live in /etc/trading/trading.env (owner root, group trading, mode 0640), never in this file.

[Unit]
Description=Stock Trading System web app (Gunicorn)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=trading
Group=trading
WorkingDirectory=/opt/trading
EnvironmentFile=/etc/trading/trading.env
# Never read a .env file in production: all settings come from the file above.
Environment=FLASK_SKIP_DOTENV=1
# --no-control-socket: nothing uses Gunicorn's control interface, and its socket can't be created without a home.
ExecStart=/opt/trading/.venv/bin/gunicorn -c deploy/gunicorn.conf.py --no-control-socket "app:create_app()"
Restart=on-failure
RestartSec=5

# Hardening: no privilege gain, a read-only system, a private /tmp, and nothing but loopback networking
# plus the database.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027

[Install]
WantedBy=multi-user.target
