# Cloudflare Tunnel (D28): copy to /etc/cloudflared/config.yml and fill in the tunnel ID and hostname.
# Create the tunnel with `cloudflared tunnel create trading`; its credentials file is a secret (mode 0600).
# The tunnel connects out to Cloudflare, so the container needs no open inbound ports.

tunnel: <TUNNEL-ID>
credentials-file: /etc/cloudflared/<TUNNEL-ID>.json

ingress:
  # Everything for the site goes to Gunicorn on the loopback address (deploy/gunicorn.conf.py).
  - hostname: trading.example.com
    service: http://127.0.0.1:8000
    originRequest:
      httpHostHeader: trading.example.com
  # Anything else is refused.
  - service: http_status:404
